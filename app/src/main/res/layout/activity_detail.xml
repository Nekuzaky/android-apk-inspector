<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/IconButton"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/brand_soft"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:filterTouchesWhenObscured="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/actionOpen"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:text="@string/action_open" />

        <Button
            android:id="@+id/actionSettings"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:text="@string/action_settings" />

        <Button
            android:id="@+id/actionReport"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:text="@string/action_report" />

        <Button
            android:id="@+id/actionSave"
            style="@style/TabButton"
            android:text="@string/action_save" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabDetails"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:text="@string/tab_details"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tabPermissions"
            style="@style/TabButton"
            android:layout_marginEnd="6dp"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tabComponents"
            style="@style/TabButton"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/filterRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/exported_only"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/exportedSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="@color/switch_thumb"
            android:trackTint="@color/switch_track" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_soft"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
